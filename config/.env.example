# Example .env file for Teddy AI
# Copy this to .env and fill in your values

# Configuration file path
export TEDDY_CONFIG="config/teddy.yaml"

# Database configuration
export TEDDY_DB_PATH="./data/teddy.db"

# Logging
export LOG_LEVEL="INFO"
export LOG_FILE="./logs/teddy.log"

# Ollama configuration
# For Windows host running Ollama: use your Windows IP (e.g., 192.168.x.x) or 0.0.0.0
# For local development: use http://localhost:11434
export OLLAMA_API_URL="http://localhost:11434"
export OLLAMA_MODEL="qwen:7b"

# Optional: Cloud LLM APIs
# Gemini is disabled in config/teddy.yaml by default.
# export GEMINI_API_KEY="your-gemini-api-key"
# export OPENAI_API_KEY="sk-..."
# export ANTHROPIC_API_KEY="sk-ant-..."

# Optional: Speech APIs
# export GOOGLE_CLOUD_CREDENTIALS="path/to/credentials.json"

# Optional: Advanced features
# export ENABLE_CLOUD_FALLBACK="true"
# export ENABLE_CACHING="true"
# export CACHE_TTL_SECONDS="3600"

# Optional: Raspberry Pi / Remote server
# export REMOTE_API_URL="http://raspberrypi.local:8000"
# export REMOTE_AUTH_TOKEN="your-token-here"

# Optional: Development
# export DEBUG="true"
# export MOCK_STT="false"
# export MOCK_TTS="false"
# export MOCK_LLM="false"
# export LOG_PROMPTS="true"
